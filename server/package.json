{
  "name": "suprema-backend",
  "version": "1.0.0",
  "description": "Express.js REST API Backend for Suprema SaaS Platform",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "db:init": "node scripts/initDb.js",
    "db:reset": "node scripts/initDb.js --force",
    "db:migrate": "node scripts/migrate.js",
    "db:apply-supabase": "node scripts/apply-schema-to-supabase.js",
    "db:clean-test-schemas": "node scripts/cleanup-test-schemas.js",
    "db:benchmark-api": "node scripts/benchmark-api.js",
    "test": "jest",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.11.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "express-validator": "^7.2.1",
    "google-auth-library": "^11.2.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^10.0.15",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "nodemon": "^3.1.9",
    "supertest": "^7.3.1"
  }
}
