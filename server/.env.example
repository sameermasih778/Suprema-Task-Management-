# Server Environment Variables
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# ── Database (Supabase / PostgreSQL) ───────────────────────────────────
# Supabase -> Project Settings -> Database -> Connection string -> URI.
#
# Use the SESSION POOLER connection string (port 5432) for the running app:
# it multiplexes many clients over one server connection, which is what keeps
# a serverless deployment (Vercel) from exhausting the connection limit.
# The direct connection (db.<ref>.supabase.co) is only needed by the
# migration scripts, never by the running app.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# The schema the tests run in. The test harness sets this itself; leave it
# unset outside the test suite.
# DB_SEARCH_PATH=
# Connections per server process. Lower this if your hosted DB has a small
# max_connections limit (each serverless instance opens its own pool).
DB_CONNECTION_LIMIT=5

# Cloud storage for avatars + task attachments (Cloudinary).
# REQUIRED in production (Vercel): the serverless filesystem is read-only, so
# uploads to disk would fail there. When unset, files are stored in
# server/uploads/ (local development). Get the URL from the Cloudinary
# dashboard: Settings -> API Keys -> "cloudinary://key:secret@cloud_name"
CLOUDINARY_URL=

# Email (Gmail SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password_here
# How long a request waits for SMTP before continuing in the background.
# Gmail's TLS handshake can take 15s+ on some networks; the pooled connection
# (config/mailer.js) makes that a once-per-process cost instead of per email.
SMTP_WAIT_MS=5000

# Security & JWT Configuration
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# Google sign-in ("Continue with Google" on the member login page).
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID.
# Leave empty and the button is hidden entirely.
GOOGLE_CLIENT_ID=

# Security Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Frontend origin used to build password-reset links in emails.
# Set this in production - CLIENT_ORIGIN's first entry may be a localhost dev origin.
FRONTEND_URL=https://superma-task-management.vercel.app
